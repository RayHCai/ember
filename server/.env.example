# Copy to server/.env and fill in. server/.env is gitignored.

# ASI:One API key for agent reasoning. Leave empty to use the fallback pipeline.
ASI1_API_KEY=

# ElevenLabs text to speech for alert audio and voice replies.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Sim seconds per real second. Demo mode uses 360 (12 hours in 2 minutes).
EMBER_SIM_SPEED=1

# Optional SpacetimeDB event store (Prompt 10).
SPACETIMEDB_URL=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=
