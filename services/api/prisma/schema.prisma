generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Civilian {
  id             String   @id @default(uuid()) @db.Uuid
  number         Int      @unique @default(autoincrement())
  /// Lowercased.
  email          String   @unique
  zipCode        String   @map("zip_code")
  civilianAreaId String?  @map("civilian_area_id")
  zoneId         String?  @map("zone_id")
  /// LatLng.
  location       Json?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([zoneId])
  @@map("civilians")
}

model Counter {
  name  String @id
  value Int

  @@map("counters")
}

// Record tables: the contract shape as jsonb, read and written by src/store/collection.ts.

model WatchZoneRecord {
  id        String   @id
  zoneId    String?  @map("zone_id")
  doc       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([zoneId])
  @@map("watch_zones")
}

