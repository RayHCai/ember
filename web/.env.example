# Copy to web/.env and fill in. web/.env is gitignored.

# The logic service. Leave empty to run on the built-in dummy data.
VITE_SERVER_URL=

# Cesium ion token: World Terrain and satellite imagery (map fallback 1).
VITE_CESIUM_ION_TOKEN=

# Google Maps key: Photorealistic 3D Tiles (primary map).
VITE_GOOGLE_MAPS_API_KEY=
