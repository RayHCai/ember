{
    "name": "ember",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "lint": "oxlint --deny-warnings && turbo run lint",
        "lint:fix": "oxlint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check . && turbo run format:check",
        "clean": "turbo run clean && rm -rf .turbo",
        "demo": "node scripts/demo.mjs",
        "demo:laptop": "node scripts/demo.mjs --remote-edge",
        "prepare": "node scripts/install-hooks.mjs"
    },
    "devDependencies": {
        "@types/node": "^24.12.0",
        "lefthook": "^2.1.10",
        "oxlint": "^1.76.0",
        "prettier": "^3.9.6",
        "turbo": "^2.10.7",
        "typescript": "^5.9.0",
        "vitest": "^4.0.0"
    }
}
