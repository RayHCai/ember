{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ember-contact-collector",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-03",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
    },
    "vars": {
        "API_URL": "http://127.0.0.1:4001",
    },
}
