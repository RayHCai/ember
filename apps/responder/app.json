{
    "expo": {
        "name": "Ember Responder",
        "slug": "ember-responder",
        "scheme": "ember",
        "version": "0.1.0",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "ios": {
            "bundleIdentifier": "dev.ember.responder",
            "supportsTablet": true
        },
        "android": {
            "package": "dev.ember.responder",
            "edgeToEdgeEnabled": true
        },
        "plugins": [
            "expo-router",
            [
                "expo-camera",
                {
                    "cameraPermission": "Ember uses the camera to scan the watch site code on the operator dashboard.",
                    "recordAudioAndroid": false
                }
            ],
            "expo-notifications"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
