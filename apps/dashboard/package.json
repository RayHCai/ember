{
    "name": "@ember/dashboard",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests --noEmit",
        "test:e2e": "playwright test",
        "tauri": "tauri",
        "app": "tauri dev",
        "app:build": "tauri build",
        "lint": "node ../../scripts/cargo.mjs clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
        "format:check": "node ../../scripts/cargo.mjs fmt --manifest-path src-tauri/Cargo.toml --check"
    },
    "dependencies": {
        "@ember/contracts": "workspace:*",
        "@fontsource/atkinson-hyperlegible": "^5.3.0",
        "@fontsource/gloock": "^5.3.0",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-log": "^2.10.1",
        "cesium": "~1.146.0",
        "motion": "^14.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@tauri-apps/cli": "^2.12.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "vite": "^8.3.5",
        "vite-plugin-cesium": "^1.2.23"
    }
}
