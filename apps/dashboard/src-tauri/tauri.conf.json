{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Ember Dashboard",
    "version": "0.0.0",
    "identifier": "dev.ember.dashboard",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Ember",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 700,
                "center": true,
                "resizable": true,
                "backgroundColor": "#FBF8F5",
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": {
                    "x": 26,
                    "y": 30
                }
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Utility",
        "shortDescription": "Wildfire watch operator console",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "12.0",
            "signingIdentity": "-"
        }
    }
}
